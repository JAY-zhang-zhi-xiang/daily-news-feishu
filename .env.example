DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_MODE=disabled

FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_BOT_SECRET=

NEWS_HOURS=24
MAX_ARTICLES=80
VALUE_SCORE_CANDIDATES=60
MAX_SUMMARY_ITEMS=20
# Optional: route RSS fetching through a local proxy when global feeds are unreachable.
# RSS_PROXY=http://127.0.0.1:7890

# RSS or OPML sources separated by commas
RSS_FEEDS=https://www.people.com.cn/rss/politics.xml,https://www.chinadaily.com.cn/rss/china_rss.xml,https://www.chinadaily.com.cn/rss/bizchina_rss.xml,https://cn.nytimes.com/rss/zh-hans/,https://www.npr.org/rss/rss.php?id=1001,https://www.theguardian.com/world/rss,https://rss.nytimes.com/services/xml/rss/nyt/World.xml,https://www.reddit.com/r/worldnews/.rss,https://www.reddit.com/r/technology/.rss
