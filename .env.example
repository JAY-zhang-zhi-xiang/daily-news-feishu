DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_MODE=disabled

FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Required only when the bot has "signature verification" enabled in Feishu.
# If signatures are on and this stays empty, every send fails the signature check.
FEISHU_BOT_SECRET=

NEWS_HOURS=24
MAX_ARTICLES=80
VALUE_SCORE_CANDIDATES=60
MAX_SUMMARY_ITEMS=20
# Optional: route RSS fetching through a local proxy when global feeds are unreachable.
# RSS_PROXY=http://127.0.0.1:7890

# Optional: where sent_history.jsonl and interest.json are stored.
# Defaults to <project>/data. Point it outside the checkout on servers.
# NEWS_DATA_DIR=

# RSS or OPML sources separated by commas.
# Note: reddit.com feeds frequently return HTTP 429 to scripted requests and
# will slow startup; prefer publisher feeds over Reddit aggregators.
RSS_FEEDS=https://www.chinanews.com.cn/rss/china.xml,https://www.chinanews.com.cn/rss/finance.xml,https://cn.nytimes.com/rss/zh-hans/,https://www.npr.org/rss/rss.php?id=1001,https://www.theguardian.com/world/rss,https://rss.nytimes.com/services/xml/rss/nyt/World.xml
